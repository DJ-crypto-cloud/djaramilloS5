<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:djaramilloS5.Models"
             x:Class="djaramilloS5.Views.vPersona"
             Title="Personas">

    <Grid Padding="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

        <Label Text="Registro de personas"
               FontSize="22"
               HorizontalOptions="Center" />

        <Entry x:Name="txtName"
               Grid.Row="1"
               Placeholder="Ingrese el nombre" />

        <Button x:Name="btnAgregar"
                Grid.Row="2"
                Text="Agregar Persona"
                Clicked="btnAgregar_Clicked" />

        <Label x:Name="lblStatusMessage"
               Grid.Row="3"
               TextColor="Gray" />

        <Button x:Name="btnMostrar"
                Grid.Row="4"
                Text="Mostrar Personas"
                Clicked="btnMostrar_Clicked" />

        <Button x:Name="btnEliminar"
                Grid.Row="5"
                Text="Eliminar Seleccionado"
                BackgroundColor="IndianRed"
                Clicked="btnEliminar_Clicked" />

        <CollectionView x:Name="listaPersonas"
                        Grid.Row="6"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Persona">
                    <Grid Padding="5" ColumnDefinitions="50,*">
                        <Label Text="{Binding Id}" />
                        <Label Grid.Column="1" Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
